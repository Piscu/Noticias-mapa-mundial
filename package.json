{
  "name": "noticias-mapa-mundial",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mapa mundial de noticias destacadas en español, geolocalizadas y filtrables por temática",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "start": "tsx src/servidor.ts",
    "build": "tsc -p tsconfig.json",
    "estatico": "tsx src/herramientas/publicar.ts",
    "recopilar": "tsx src/cli.ts",
    "mapa": "tsx src/herramientas/mapa.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.2",
    "node-cron": "^4.6.0",
    "scripts": "^0.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
